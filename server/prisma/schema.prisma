// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RoleName {
  FRESHER
  CLIENT
  MENTOR
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String?
  name         String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  googleId     String?   @unique
  githubId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  skills       UserSkill[]
  jobs        Job[]
  applications    Application[]  @relation("FresherApplications")
mentorReviews   MentorReview[] @relation("MentorReviews")
fresherReviews  MentorReview[] @relation("FresherReviews")
portfolio     PortfolioItem[]
notifications Notification[]
fresherConversations Conversation[] @relation("FresherConversations")
clientConversations  Conversation[] @relation("ClientConversations")
sentMessages         Message[]      @relation("SentMessages")
posts     Post[]
comments  Comment[]
reactions Reaction[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  bio           String?  @db.Text
  education     String?
  resumeUrl     String?
  githubUrl     String?
  linkedinUrl   String?
  hourlyRate    Float?
  availability  Boolean  @default(true)
  tier          Int      @default(1)
}

model Skill {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  id       Int     @id @default(autoincrement())
  userId   Int
  skillId  Int
  verified Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id])
  skill    Skill   @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}
model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  budget      Float
  tierRequired Int      @default(1)
  skills      String
  isRemote    Boolean   @default(true)
  status      JobStatus @default(OPEN)
  clientId    Int
  client      User      @relation(fields: [clientId], references: [id])
  createdAt   DateTime  @default(now())
  applications Application[]
  updatedAt   DateTime  @updatedAt
}

enum JobStatus {
  OPEN
  CLOSED
  IN_PROGRESS
}
model Application {
  id          Int               @id @default(autoincrement())
  jobId       Int
  fresherId   Int
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  job         Job               @relation(fields: [jobId], references: [id])
  fresher     User              @relation("FresherApplications", fields: [fresherId], references: [id])
  review      MentorReview?
  conversation  Conversation?
  @@unique([jobId, fresherId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model MentorReview {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique
  mentorId      Int
  fresherId     Int
  rating        Int
  review        String      @db.Text
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  mentor        User        @relation("MentorReviews", fields: [mentorId], references: [id])
  fresher       User        @relation("FresherReviews", fields: [fresherId], references: [id])
}
model PortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String   @db.Text
  techStack   String
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

enum NotificationType {
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  APPLICATION_COMPLETED
  MENTOR_REVIEW
  TIER_UPGRADE
  NEW_APPLICANT
  JOB_POSTED
}
model Conversation {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique
  fresherUserId Int
  clientUserId  Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  application   Application @relation(fields: [applicationId], references: [id])
  fresher       User      @relation("FresherConversations", fields: [fresherUserId], references: [id])
  client        User      @relation("ClientConversations", fields: [clientUserId], references: [id])
  messages      Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String       @db.Text
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
} 
model Post {
  id        Int        @id @default(autoincrement())
  userId    Int
  title     String
  content   String     @db.Text
  type      PostType   @default(QUESTION)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  comments  Comment[]
  reactions Reaction[]
}

enum PostType {
  QUESTION
  SHOWCASE
  FEEDBACK
  DISCUSSION
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Reaction {
  id        Int          @id @default(autoincrement())
  postId    Int
  userId    Int
  type      ReactionType @default(LIKE)
  post      Post         @relation(fields: [postId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  @@unique([postId, userId])
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
}